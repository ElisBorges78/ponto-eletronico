{
  "name": "Notifica\u00e7\u00e3o de Regras de Ponto",
  "description": "Notifica professores por email quando as regras de restri\u00e7\u00e3o de hor\u00e1rio s\u00e3o atualizadas na Configuracao",
  "trigger": {
    "config": {
      "trigger_type": "entity",
      "entity_name": "Configuracao",
      "events": [
        "update"
      ]
    },
    "condition": "${ any((.trigger.changed_fields // [])[]; . | IN(\"restricoes_ativas\", \"hora_min_entrada\", \"hora_max_entrada\", \"hora_min_saida\", \"hora_max_saida\", \"mensagem_regras\")) }"
  },
  "definition": {
    "document": {
      "dsl": "1.0.0",
      "name": "notificar_regras_ponto",
      "version": "1.0",
      "namespace": "base44"
    },
    "do": [
      {
        "notificar": {
          "call": "invoke_backend_function",
          "with": {
            "function_name": "notificarRegrasConfiguracao"
          },
          "then": "end",
          "x-base44": {
            "title": "Notificar professores",
            "description": "Envia email com novas regras de ponto"
          }
        }
      }
    ]
  }
}