{
  "name": "Professor",
  "type": "object",
  "properties": {
    "nome": {
      "type": "string",
      "description": "Nome completo do professor"
    },
    "email": {
      "type": "string",
      "description": "Email do professor"
    },
    "telefone": {
      "type": "string",
      "description": "Telefone de contato"
    },
    "matricula": {
      "type": "string",
      "description": "N\u00famero de matr\u00edcula"
    },
    "disciplina": {
      "type": "string",
      "description": "Disciplina que leciona"
    },
    "foto_url": {
      "type": "string",
      "description": "URL da foto de refer\u00eancia para Face ID"
    },
    "ativo": {
      "type": "boolean",
      "default": true,
      "description": "Se o professor est\u00e1 ativo"
    }
  },
  "required": [
    "nome"
  ],
  "rls": {
    "read": {},
    "create": {
      "user_condition": {
        "role": "admin"
      }
    },
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}