{
  "name": "Professor",
  "type": "object",
  "properties": {
    "nome": {
      "type": "string",
      "description": "Nome completo do professor"
    },
    "email": {
      "type": "string",
      "description": "Email do professor"
    },
    "telefone": {
      "type": "string",
      "description": "Telefone de contato"
    },
    "matricula": {
      "type": "string",
      "description": "N\u00famero de matr\u00edcula"
    },
    "disciplina": {
      "type": "string",
      "description": "Disciplina que leciona"
    },
    "foto_url": {
      "type": "string",
      "description": "URL da foto de refer\u00eancia para Face ID"
    },
    "unidade": {
      "type": "string",
      "default": "IEMA Pleno Cururupu",
      "description": "Unidade/Campus de v\u00ednculo do professor"
    },
    "status_aprovacao": {
      "type": "string",
      "enum": [
        "pendente",
        "aprovado",
        "rejeitado"
      ],
      "default": "pendente",
      "description": "Status de aprova\u00e7\u00e3o do cadastro pelo gestor"
    },
    "aprovado_por": {
      "type": "string",
      "description": "Email do gestor/admin que aprovou o cadastro"
    },
    "ativo": {
      "type": "boolean",
      "default": false,
      "description": "Se o professor est\u00e1 ativo (aprovado)"
    }
  },
  "required": [
    "nome"
  ],
  "rls": {
    "read": {},
    "create": {
      "user_condition": {
        "role": "admin"
      }
    },
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}