{
  "name": "RegistroPonto",
  "type": "object",
  "properties": {
    "data": {
      "type": "string",
      "format": "date",
      "description": "Data do registro (YYYY-MM-DD)"
    },
    "professor_id": {
      "type": "string",
      "description": "ID do professor vinculado"
    },
    "professor_nome": {
      "type": "string",
      "description": "Nome do professor (denormalizado)"
    },
    "entrada": {
      "type": "string",
      "format": "date-time",
      "description": "Hor\u00e1rio de entrada"
    },
    "saida_almoco": {
      "type": "string",
      "format": "date-time",
      "description": "In\u00edcio do intervalo de almo\u00e7o"
    },
    "retorno_almoco": {
      "type": "string",
      "format": "date-time",
      "description": "Fim do intervalo de almo\u00e7o"
    },
    "saida": {
      "type": "string",
      "format": "date-time",
      "description": "Hor\u00e1rio de sa\u00edda"
    },
    "observacao": {
      "type": "string",
      "description": "Observa\u00e7\u00f5es do dia"
    },
    "ajustado_por": {
      "type": "string",
      "description": "Email do admin que ajustou o registro"
    }
  },
  "required": [
    "data"
  ],
  "rls": {
    "read": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "create": {},
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}